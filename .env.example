# Cloudflare Images / R2 (never commit real tokens)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
PUBLIC_CLOUDFLARE_IMAGES_BASE=
# Example: https://imagedelivery.net/<account_hash>
# Example: https://images.openhouseupdate.com
# Example: https://images.openhouseupdate.com/cdn-cgi/image
# Set PUBLIC_CLOUDFLARE_IMAGES_BASE on Vercel after R2/Images custom domain
# is DNS-only (gray cloud). Do not orange-cloud the Vercel apex.
# Worker source: workers/images.js bound to R2 bucket openhouseupdate-images.
