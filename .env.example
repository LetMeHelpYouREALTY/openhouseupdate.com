# Cloudflare Images / R2 / Worker (never commit real tokens)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
PUBLIC_CLOUDFLARE_IMAGES_BASE=
# After `pnpm images:cf-deploy` (or wrangler deploy --temporary then claim):
#   PUBLIC_CLOUDFLARE_IMAGES_BASE=https://openhouseupdate-images.<subdomain>.workers.dev
# After a DNS-only custom domain:
#   PUBLIC_CLOUDFLARE_IMAGES_BASE=https://images.openhouseupdate.com
# Cloudflare Images API:
#   PUBLIC_CLOUDFLARE_IMAGES_BASE=https://imagedelivery.net/<account_hash>
# Git copies in /public/images remain the backup. Do not orange-cloud the Vercel apex.
# Worker source: workers/images.js with [assets] binding ASSETS (public/images).
