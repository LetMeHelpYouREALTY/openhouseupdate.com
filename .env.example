# Cloudflare Images / R2 / Worker (never commit real tokens)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
PUBLIC_CLOUDFLARE_IMAGES_BASE=
# Live <img> origin defaults to Cloudflare CDN of the git JPEGs:
#   https://cdn.jsdelivr.net/gh/LetMeHelpYouREALTY/openhouseupdate.com@main/public/images
# HeadingImage onError still falls back to /images/<file> on Vercel.
# After a DNS-only custom domain on the same Cloudflare account as the Worker:
#   PUBLIC_CLOUDFLARE_IMAGES_BASE=https://images.openhouseupdate.com
# Cloudflare Images API:
#   PUBLIC_CLOUDFLARE_IMAGES_BASE=https://imagedelivery.net/<account_hash>
# Do not set PUBLIC_CLOUDFLARE_IMAGES_BASE to *.workers.dev (Bot Fight 403) or
# trycloudflare.com (expires). Do not orange-cloud the Vercel apex.
# Worker source: workers/images.js with [assets] binding ASSETS (public/images).
